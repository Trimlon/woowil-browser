{
  "name": "woowil",
  "version": "0.4.1",
  "private": true,
  "description": "Woowil - a minimal custom browser built on Electron.",
  "author": "Trimlon",
  "license": "GPL-3.0-or-later",
  "main": "src/main.js",
  "scripts": {
    "prestart": "node scripts/bundle-preloads.js",
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage",
    "build:win": "electron-builder --win portable",
    "build:win-installer": "electron-builder --win nsis",
    "build:all": "electron-builder --linux AppImage --win portable",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "dk.woowil.app",
    "productName": "Woowil",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Trimlon",
      "repo": "woowil-browser",
      "private": false
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Network",
      "artifactName": "${productName}.${ext}"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-chrome-extensions": "^4.9.0",
    "electron-updater": "^6.8.9"
  }
}
